{
  "name": "crpg-character-manager",
  "private": true,
  "version": "0.1.0",
  "description": "A web tool for managing CRPG character builds and progression",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "preview": "vite preview",
    "test:run": "vitest run",
    "security:csp": "node scripts/check-csp.js",
    "security:imports": "node scripts/check-import-safety.js",
    "security:dangerous": "node scripts/check-dangerous-patterns.js",
    "security:gate": "npm run security:csp && npm run security:imports && npm run security:dangerous",
    "ci": "npm run security:gate && npm run test:run && npm run build",
    "optimize:images": "node scripts/optimize-images.js",
    "images:dry": "node scripts/convert-images-to-webp-and-rewrite.js --dry-run",
    "images:convert": "node scripts/convert-images-to-webp-and-rewrite.js",
    "images:convert:keep": "node scripts/convert-images-to-webp-and-rewrite.js --keep-originals",
    "images:webp": "node scripts/convert-images-to-webp-and-rewrite.js",
    "images:webp:keep": "node scripts/convert-images-to-webp-and-rewrite.js --keep-originals"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "iconoir-react": "^7.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
